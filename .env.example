# Copy this file to .env.local and fill in the values from your own Supabase
# project (Project Settings -> API). Never commit .env.local — it's gitignored.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Grants full admin access to your database — never expose this
# to browser code or commit it anywhere. Required only for account deletion
# (src/app/api/account/route.ts).
SUPABASE_SERVICE_ROLE_KEY=
